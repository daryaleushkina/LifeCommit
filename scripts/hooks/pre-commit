#!/bin/sh
# Настройки IDE владелицы (.idea/) не уезжают в коммит (AGENTS.md, «Нельзя»). Скиллы .claude/skills и .mcp.json
# коммитятся обычными PR, как остальной код (решение владелицы 08.10.2026). Удаление не ловим — только добавленное и
# изменённое в индексе. Тест: scripts/hooks/git-hooks.test.ts.

staged="$(git diff --cached --name-only --diff-filter=ACMR -- .idea)"
[ -z "$staged" ] && exit 0

{
  echo "pre-commit: в коммит попали настройки IDE владелицы (.idea/, AGENTS.md):"
  printf '%s\n' "$staged" | sed 's/^/  /'
  echo "Убери их из индекса: git restore --staged -- .idea"
} >&2
exit 1
