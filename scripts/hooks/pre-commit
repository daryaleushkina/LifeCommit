#!/bin/sh
# Файлы, которые правит и коммитит сама владелица (CLAUDE.md: .claude/skills/*, .mcp.json, .idea/*), не уезжают
# в чужой коммит. Удаление не ловим — только добавленное и изменённое в индексе. Тест: scripts/hooks/git-hooks.test.ts.

staged="$(git diff --cached --name-only --diff-filter=ACMR -- .claude/skills .mcp.json .idea)"
[ -z "$staged" ] && exit 0

{
  echo "pre-commit: в коммит попали файлы, которые правит владелица (CLAUDE.md):"
  printf '%s\n' "$staged" | sed 's/^/  /'
  echo "Убери их из индекса: git restore --staged -- .claude/skills .mcp.json .idea"
} >&2
exit 1
