{
  "name": "lifecommit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "pnpm build && wrangler dev --env-file .dev.vars.prod",
    "db:start": "supabase start -x realtime,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit,studio,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "load": "k6 run scripts/load.js",
    "e2e": "playwright test",
    "e2e:coverage": "E2E_COVERAGE=1 playwright test --project=android-light && node scripts/e2e-coverage.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -b",
    "lint": "oxlint src worker shared site e2e",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "eval:voice": "vitest run --config vitest.eval.config.ts",
    "check:tma": "bash .claude/skills/telegram-mini-app/scripts/check.sh src",
    "bot:setup": "node scripts/setup-bot.mjs",
    "hooks:install": "git config core.hooksPath scripts/hooks",
    "mac:test": "swift test --package-path macos",
    "mac:build": "bash macos/build.sh",
    "mac:install": "bash macos/build.sh --install",
    "apple:test": "bash apple/scripts/test.sh",
    "apple:open": "cd apple && xcodegen generate && open LifeCommit.xcodeproj",
    "apple:icons": "node apple/scripts/icons.mjs",
    "android:test": "cd android && ./gradlew :core:test :app:verifyRoborazziDebug --console=plain",
    "android:record": "cd android && ./gradlew :app:recordRoborazziDebug --console=plain",
    "android:build": "cd android && ./gradlew :app:assembleDebug --console=plain",
    "android:icons": "node android/scripts/icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tma.js/init-data-node": "^2.0.8",
    "@tma.js/sdk-react": "^3.0.23",
    "gsap": "^3.15.0",
    "hono": "^4.13.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "jsqr": "^1.4.0",
    "monocart-coverage-reports": "^2.13.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "^1.63.0",
    "supabase": "^2.118.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vitest-browser-react": "2.3.0",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@11.17.0"
}
