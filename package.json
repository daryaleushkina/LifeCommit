{
  "name": "lifecommit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "pnpm build && wrangler dev --env-file .dev.vars.prod",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor,mailpit,studio,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "load": "k6 run scripts/load.js",
    "e2e": "playwright test",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:tma": "bash .claude/skills/telegram-mini-app/scripts/check.sh src",
    "bot:setup": "node scripts/setup-bot.mjs",
    "hooks:install": "git config core.hooksPath scripts/hooks"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tma.js/init-data-node": "^2.0.8",
    "@tma.js/sdk-react": "^3.0.23",
    "hono": "^4.13.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "supabase": "^2.118.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@11.17.0"
}
