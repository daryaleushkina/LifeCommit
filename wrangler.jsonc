{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifecommit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  // Статика без SPA-заглушки: мини-апп — /app/ (у него нет своих путей), чего нет в статике — решает Worker.
  // Лендинг и документы — без языка в адресе: язык выбирает Worker (worker/site.ts), старые /ru/… и /en/… он же
  // переадресует, поэтому они идут через Worker, хотя такие файлы в статике есть.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/bot/*", "/google/*", "/share/*", "/", "/privacy", "/privacy/", "/terms", "/terms/", "/lang/*", "/ru", "/ru/*", "/en", "/en/*"]
  },
  // Напоминания: раз в 15 минут смотрим, у кого сейчас время напоминания (там же — срок хранения жалоб).
  // Раз в 5 минут — черновики жалоб /bug: после 10 минут тишины жалоба уходит сама (worker/feedbackBot.ts).
  "triggers": { "crons": ["*/15 * * * *", "*/5 * * * *"] },
  // Workers AI: голос и свободный текст → привычки (бесплатно 10 000 нейронов в день на аккаунт).
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Каждый запрос несколько раз ходит в базу во Франкфурт: пусть Cloudflare исполняет код ближе к ней,
  // а не к пользователю — тогда длинная дорога одна, а не на каждый запрос к базе.
  "placement": { "mode": "smart" },
  // Свой домен (куплен 01.10.2026 в Cloudflare Registrar) — для проверки приложения Google.
  // workers.dev остаётся: по нему ещё открываются старые ссылки и кнопки в сообщениях.
  "routes": [{ "pattern": "lifecommit.app", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://jxiehidneahivjebijae.supabase.co",
    "BOT_USERNAME": "LifeCommit_bot",
    "APP_URL": "https://lifecommit.app",
    // Клиент OAuth Google (проект LifeCommit в Google Cloud) — не секрет; секрет — GOOGLE_CLIENT_SECRET.
    "GOOGLE_CLIENT_ID": "315642604889-jn5ll59j0lgi8t7qipeprieehkpqf4i1.apps.googleusercontent.com",
    // Telegram id владелицы (не секрет): бот присылает ей каждую новую жалобу (docs/feedback.md).
    "OWNER_ID": "1481689738"
  }
  // Секреты (wrangler secret put): TELEGRAM_BOT_TOKEN, SUPABASE_SECRET_KEY, TELEGRAM_WEBHOOK_SECRET, GOOGLE_CLIENT_SECRET
}
