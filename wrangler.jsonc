{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifecommit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bot/*", "/google/*"]
  },
  // Напоминания: раз в 15 минут смотрим, у кого сейчас время напоминания.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Workers AI: голос и свободный текст → привычки (бесплатно 10 000 нейронов в день на аккаунт).
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  // Каждый запрос несколько раз ходит в базу во Франкфурт: пусть Cloudflare исполняет код ближе к ней,
  // а не к пользователю — тогда длинная дорога одна, а не на каждый запрос к базе.
  "placement": { "mode": "smart" },
  "vars": {
    "SUPABASE_URL": "https://jxiehidneahivjebijae.supabase.co",
    "BOT_USERNAME": "LifeCommit_bot",
    "APP_URL": "https://lifecommit.daryaleushkina.workers.dev",
    // Клиент OAuth Google (проект LifeCommit в Google Cloud) — не секрет; секрет — GOOGLE_CLIENT_SECRET.
    "GOOGLE_CLIENT_ID": "315642604889-jn5ll59j0lgi8t7qipeprieehkpqf4i1.apps.googleusercontent.com"
  }
  // Секреты (wrangler secret put): TELEGRAM_BOT_TOKEN, SUPABASE_SECRET_KEY, TELEGRAM_WEBHOOK_SECRET, GOOGLE_CLIENT_SECRET
}
