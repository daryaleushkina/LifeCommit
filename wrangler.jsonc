{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifecommit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/bot/*"]
  },
  // Напоминания: раз в 15 минут смотрим, у кого сейчас время напоминания.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://jxiehidneahivjebijae.supabase.co",
    "BOT_USERNAME": "LifeCommit_bot",
    "APP_URL": "https://lifecommit.daryaleushkina.workers.dev"
  }
  // Секреты (wrangler secret put): TELEGRAM_BOT_TOKEN, SUPABASE_SECRET_KEY, TELEGRAM_WEBHOOK_SECRET
}
