<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Установлен ли Telegram: вход тогда идёт через него (docs/mobile.md, «Вход»). -->
    <queries>
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
        <!-- Custom Tab для страницы входа Telegram. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- Ключ сессии в резервную копию и на другое устройство не уезжает (allowBackup=false, правила ниже). -->
    <application
        android:name=".LifeCommitApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="LifeCommit"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeCommit"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Возврат из Telegram после входа: lifecommit://tglogin?code=… Код принимается, только пока ждём вход
                 (AppModel), и обменивается нашим PKCE — чужой код в нашу сессию не превратить. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lifecommit" android:host="tglogin" />
            </intent-filter>
            <!-- Возврат после входа Google (подключение календаря): lifecommit://calendars?status=ok|again|denied|expired|failed.
                 В адресе только итог, без токенов (docs/mobile.md). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lifecommit" android:host="calendars" />
            </intent-filter>
            <!-- Приглашения (решение владелицы 05.10): проверенный App Link lifecommit.app/j/<код> (в группу) и /f/<код>
                 (в друзья) — assetlinks.json сайта с отпечатком нашего ключа подписи. Код сверяется в AppModel.invitePath. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="lifecommit.app" android:pathPrefix="/j/" />
                <data android:scheme="https" android:host="lifecommit.app" android:pathPrefix="/f/" />
            </intent-filter>
            <!-- Кнопка «Открыть в приложении» на странице приглашения (там, где App Link не сработал). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lifecommit" android:host="join" />
                <data android:scheme="lifecommit" android:host="friend" />
            </intent-filter>
        </activity>
    </application>
</manifest>
